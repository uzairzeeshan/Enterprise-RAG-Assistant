APP_NAME="Enterprise Multi-Source RAG Assistant"
ENVIRONMENT="development"
SECRET_KEY="super-secret-jwt-key-change-in-production-enterprise-rag"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite:///./data/enterprise_rag.db"

# Vector DB & Embeddings
VECTOR_DB_DIR="./data/chroma_db"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
CROSS_ENCODER_MODEL_NAME="cross-encoder/ms-marco-MiniLM-L-6-v2"

# LLM Providers (Set API keys if available; fallback to mock/local mode if not set)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
LLM_PROVIDER="mock"  # Options: "mock", "gemini", "openai"
DEFAULT_MODEL_NAME="gemini-1.5-flash"

# File Upload Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=25

# Admin Seed Account
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@enterprise.rag"
ADMIN_PASSWORD="adminpassword123"
